# Source-repository configuration, maintained by this project.
# Consumer teams own their .editorconfig; framework installation and upgrades
# do not distribute or manage this file. Optional snippets require team adoption.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
max_line_length = 150
trim_trailing_whitespace = true

# Package metadata, schemas and project configuration.
[*.{json,yaml,yml}]
indent_size = 2

# Framework tooling and tests.
[*.py]
indent_size = 4

[*.{ps1,sh}]
indent_size = 2

# XML files in the retained .NET knowledge examples.
[*.{csproj,props,Config}]
indent_size = 2
