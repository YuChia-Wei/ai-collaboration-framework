<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <!-- Exact published DLLs are supplied explicitly; no feed or package restore. -->
  <ItemGroup>
    <Reference Include="ArchPrecept.Contracts.Domain">
      <HintPath>$(PublishedContractsDir)/domain/lib/net8.0/ArchPrecept.Contracts.Domain.dll</HintPath>
    </Reference>
    <Reference Include="ArchPrecept.Contracts.Domain.EventSourcing">
      <HintPath>$(PublishedContractsDir)/eventsourcing/lib/net8.0/ArchPrecept.Contracts.Domain.EventSourcing.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequirePublishedContracts" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PublishedContractsDir)' == ''" Text="Supply verified 0.0.3-preview DLLs via PublishedContractsDir; see BASELINE.md." />
  </Target>
</Project>
