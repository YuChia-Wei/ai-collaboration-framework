<!--
  Reference-in-place analyzer wiring plan.

  First record an authorized target-owned reference-in-place plan. The target
  owner may then apply and evidence this ItemGroup in its own Directory.Build.props.
  Invocation evidence can support a fresh active record only after that applied
  wiring exists. The provider never applies this snippet or copies production source.

  The project remains at the canonical profile path while this pre-cutover
  source-only provider is active.
-->
<Project>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory).ai/assets/tech-stacks/dotnet-backend/tooling/bundled-mechanical-validation/analyzers/DotnetBackendAnalyzers.csproj')">
    <ProjectReference
      Include="$(MSBuildThisFileDirectory).ai/assets/tech-stacks/dotnet-backend/tooling/bundled-mechanical-validation/analyzers/DotnetBackendAnalyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>
</Project>
