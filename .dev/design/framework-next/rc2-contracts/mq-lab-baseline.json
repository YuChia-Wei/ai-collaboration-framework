      "effective_disposition": "baseline-effective",
      "rule_id": "PROJECT-GRAMMAR-001"
    },
    {
      "applicability": "Testing, persistence, messaging, and observability choices are explicit, evidence-backed, and recorded in target configuration.",
      "effective_disposition": "baseline-effective",
      "rule_id": "TECH-SELECT-001"
    },
    {
      "applicability": "The dotnet-backend profile applies and the target explicitly selects the baseline-permitted plain-xUnit branch with mandatory GWT semantics.",
      "effective_disposition": "baseline-effective",
      "rule_id": "TEST-BDDFY-001"
