{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "S1 documentation only; cross-field constraints, exact lexical integer checks, duplicate-key rejection, budgets and identity algorithms are in formats.md. No current parser support or executed schema compliance is claimed.",
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob",
        "mode",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "git_blob": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "mode": {
          "enum": [
            "100644",
            "100755"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "CatalogPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "catalog_sha256",
        "files_sha256"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^catalog:1:.+:[0-9a-f]{64}$"
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "knowledge"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "OptionalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "on_missing"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "knowledge"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "on_missing": {
          "const": "unavailable"
        }
      }
    },
    "Selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "operations",
        "path_prefixes",
        "technology_profile",
        "file_types",
        "execution_modes"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "path_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\\\:]+$"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "technology_profile": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "file_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "execution_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        }
      }
    },
    "Authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "selector"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "package",
        "resources",
        "use_as",
        "selector",
        "authorities",
        "required_rule_ids",
        "required_for_coverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "package": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "use_as": {
          "enum": [
            "knowledge",
            "example",
            "normative-rule"
          ]
        },
        "selector": {
          "$ref": "#/$defs/Selector"
        },
        "authorities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Authority"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "required_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "required_for_coverage": {
          "type": "boolean"
        }
      }
    },
    "PresetTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "catalog_identity",
        "preset_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "catalog_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "preset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_version",
        "catalog",
        "skills",
        "knowledge",
        "adapters",
        "bindings"
      ],
      "properties": {
        "selection_version": {
          "const": 1
        },
        "catalog": {
          "$ref": "#/$defs/CatalogPin"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "knowledge": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "adapters": {
          "type": "array",
          "items": {
            "enum": [
              "codex",
              "claude"
            ]
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "expanded_from": {
          "$ref": "#/$defs/PresetTrace"
        }
      }
    },
    "ContentMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "kind": {
          "enum": [
            "metadata",
            "index",
            "knowledge",
            "example",
            "normative-rule",
            "rule-catalog",
            "template",
            "source-include"
          ]
        }
      }
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "rule_ids",
        "capabilities",
        "operations",
        "technology_profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "kind": {
          "enum": [
            "knowledge",
            "example",
            "normative-rule",
            "rule-catalog",
            "template",
            "source-include"
          ]
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "technology_profile": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "resource_id",
        "target",
        "requirement",
        "on_missing"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "path",
            "anchor"
          ],
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[^\\\\:]+$"
            },
            "anchor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "on_missing": {
          "const": "unavailable"
        }
      }
    },
    "ContentPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_package_version",
        "id",
        "version",
        "entrypoint",
        "members",
        "resources",
        "dependencies",
        "references"
      ],
      "properties": {
        "content_package_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentMember"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "optional"
          ],
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Dependency"
              },
              "minItems": 0,
              "maxItems": 4096,
              "uniqueItems": true
            },
            "optional": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/OptionalDependency"
              },
              "minItems": 0,
              "maxItems": 4096,
              "uniqueItems": true
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        }
      }
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "metadata_version",
        "metadata",
        "members",
        "required_dependencies",
        "optional_dependencies"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "knowledge"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "metadata_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "metadata": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\\\:]+$"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "required_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "optional_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionalDependency"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        }
      }
    },
    "Adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "prefix",
        "template",
        "members"
      ],
      "properties": {
        "id": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "prefix": {
          "const": "aicf-"
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\\\:]+$"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        }
      }
    },
    "Preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_version",
        "id",
        "version",
        "skills",
        "knowledge",
        "adapters"
      ],
      "properties": {
        "preset_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "knowledge": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "adapters": {
          "type": "array",
          "items": {
            "enum": [
              "codex",
              "claude"
            ]
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        }
      }
    },
    "Generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "implementation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "implementation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        }
      }
    },
    "Catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_version",
        "release_version",
        "source",
        "components",
        "adapters",
        "presets",
        "build_inputs",
        "generator"
      ],
      "properties": {
        "catalog_version": {
          "const": 1
        },
        "release_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-rc\\.[1-9][0-9]*)?$"
        },
        "source": {
          "$ref": "#/$defs/Origin"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Adapter"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "presets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Preset"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "build_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "generator": {
          "$ref": "#/$defs/Generator"
        }
      }
    },
    "CatalogFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "owner",
        "member",
        "source"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\:]+$"
        },
        "kind": {
          "enum": [
            "skill",
            "knowledge",
            "adapter"
          ]
