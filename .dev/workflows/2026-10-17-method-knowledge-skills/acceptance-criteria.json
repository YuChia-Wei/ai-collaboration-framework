      "criteria": [
        {
          "id": "AC01",
          "text": "入口可直接導向任務需要的檔案，不要求讀完整目錄。"
        },
        {
          "id": "AC02",
          "text": "探索-only 不強制 Gherkin；scenario-only 不重跑需求探索；組合工作保留同一來源與未知。"
        },
        {
          "id": "AC03",
          "text": "automation 說明實際檢查與證據限制，場景文字不冒充執行。"
        },
        {
          "id": "AC04",
          "text": "新 context 的實際 actor 讀取記錄證明僅載入所需、已宣告且已安裝的資源。"
        },
        {
          "id": "AC05",
          "text": "實際 package／consumer closure 與 optional absent 行為正確；舊 source paths 不成為隱藏依賴。"
        },
        {
          "id": "AC06",
          "text": "規則／場景／預期結果語意保留，文件搬移不改變下游採用。"
        }
      ]
    },
