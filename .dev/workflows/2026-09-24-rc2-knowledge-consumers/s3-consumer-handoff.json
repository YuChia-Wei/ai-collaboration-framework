    "authority_input": "Exact deduplicated closed {path,sha256,selector} allowlist from selected bindings; raw hash matched by the reader",
    "return_keys": [
      "lock_sha256",
      "candidate_identity",
      "desired_sha256",
      "resources",
      "bindings",
      "authorities",
      "semantic_applicability"
    ],
    "resource_row": [
      "package",
      "version",
      "resource_id",
      "member",
      "sha256",
      "resource"
    ],
    "ownership": "Reader verifies complete lock-2/member/authority raw identity; S5 filters index and bindings, bounded-reads only needed members with re-observation, and consults target owner for semantic rule applicability.",
    "failure": "InstallationError or DistributionError; no partial index",
    "remaining": "S3 code implementation and S6 actual use are pending; this handoff records the fixed interface only."
  },
  "scope": "Five instruction-only skill roots; shared manifest/catalog and target adoption remain S3/coordinator-owned.",
  "verification": {
    "direct": "UTF-8/YAML/resource-ID/local-link/JSON/Git/diff and exact message checks; static binding to published S3 interface",
