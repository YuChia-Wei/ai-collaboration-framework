    "status": "published-interface-aligned; implementation-in-progress",
    "published_commit": "15bca530ea9eb3cc429cd7be37acf0ba45031507",
    "published_path": ".dev/workflows/2026-09-24-rc2-selected-distribution/s5-interface.md",
    "callable": "distribution.catalog.read_installed_resources",
    "arguments": [
      "project_root",
      "expected_lock_sha256",
      "authorities"
