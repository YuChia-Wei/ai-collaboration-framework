<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <!-- Exact published DLLs are supplied explicitly; no feed or package restore. -->
  <ItemGroup>
    <Reference Include="ArchPrecept.Contracts.Domain">
      <HintPath>$(PublishedContractsDir)/domain/lib/net8.0/ArchPrecept.Contracts.Domain.dll</HintPath>
    </Reference>
    <Reference Include="ArchPrecept.Contracts.Domain.EventSourcing">
      <HintPath>$(PublishedContractsDir)/eventsourcing/lib/net8.0/ArchPrecept.Contracts.Domain.EventSourcing.dll</HintPath>
    </Reference>
    <Compile Include="../../../source-includes/domain/IDomainEntity.cs" Link="IDomainEntity.cs" />
    <Compile Include="../../../source-includes/domain/IAggregateRoot.cs" Link="IAggregateRoot.cs" />
    <Compile Include="../../../source-includes/domain/IDomainEvent.cs" Link="IDomainEvent.cs" />
    <Compile Include="../../../source-includes/domain/EsAggregateRoot.cs" Link="EsAggregateRoot.cs" />
    <Compile Include="../../aggregate/Plan.cs" Link="Plan.cs" />
    <Compile Include="../../aggregate/PlanEvents.cs" Link="PlanEvents.cs" />
    <Compile Include="../../aggregate/PlanId.cs" Link="PlanId.cs" />
    <Compile Include="../../aggregate/Project.cs" Link="Project.cs" />
    <Compile Include="../../aggregate/ProjectId.cs" Link="ProjectId.cs" />
    <Compile Include="../../aggregate/ProjectName.cs" Link="ProjectName.cs" />
    <Compile Include="../../aggregate/TaskId.cs" Link="TaskId.cs" />
    <Compile Include="../../aggregate/TagId.cs" Link="TagId.cs" />
  </ItemGroup>
  <Target Name="RequirePublishedContracts" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PublishedContractsDir)' == ''" Text="Supply verified 0.0.3-preview DLLs via PublishedContractsDir; see contract-cases.md." />
  </Target>
</Project>
